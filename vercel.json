{
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/reports/state-of-hermes-q1-2026",
      "destination": "/reports/state-of-hermes-april-2026",
      "permanent": true
    },
    {
      "source": "/projects/Eynzof/hermes-agent-cn-desktop",
      "destination": "/projects/Eynzof/Hermes-CN-Desktop",
      "permanent": true
    },
    {
      "source": "/projects/Agent-3-7/minions",
      "destination": "/projects/agent37-platform/minions",
      "permanent": true
    },
    {
      "source": "/projects/roli-lpci/lintlang",
      "destination": "/projects/hermes-labs-ai/lintlang",
      "permanent": true
    },
    {
      "source": "/projects/clawshell/clawshell",
      "destination": "/projects/runta-dev/clawshell",
      "permanent": true
    },
    {
      "source": "/projects/EKKOLearnAI/hermes-web-ui",
      "destination": "/projects/EKKOLearnAI/hermes-studio",
      "permanent": true
    },
    {
      "source": "/projects/keepnotes-ai/keep",
      "destination": "/projects/generalbusiness-ai/keep",
      "permanent": true
    },
    {
      "source": "/projects/AxDSan/mnemosyne",
      "destination": "/projects/mnemosyne-oss/mnemosyne",
      "permanent": true
    },
    {
      "source": "/projects/rookiemann/portable-hermes-agent",
      "destination": "/projects/aivrar/portable-hermes-agent",
      "permanent": true
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://hermesatlas.com"
        },
        {
          "key": "Vary",
          "value": "Origin"
        }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}
